# ═══════════════════════════════════════════════════════════════════
#  ENVIRONMENT SWITCH  ←  Change ONLY this one line to switch envs
#  Options: local | ngrok | production
# ═══════════════════════════════════════════════════════════════════
APP_ENV=local


# ── LOCAL DEVELOPMENT ───────────────────────────────────────────────
#  Used when APP_ENV=local
LOCAL_PORT=5000
LOCAL_MONGODB_URI=mongodb://localhost:27017/gifts
LOCAL_CLIENT_URL=http://localhost:3000


# ── NGROK / DEV DOMAIN ──────────────────────────────────────────────
#  Used when APP_ENV=ngrok
#  For klyro.digital subdomain testing:
#    NGROK_URL=https://klyro.digital
#    NGROK_CLIENT_URL=https://klyro.digital
#    ROOT_DOMAIN=klyro.digital
#  For plain ngrok tunnel (no subdomains):
#    NGROK_URL=https://xxxx.ngrok-free.app
#    NGROK_CLIENT_URL=http://localhost:3000,https://xxxx.ngrok-free.app
#    ROOT_DOMAIN=   (leave empty)
NGROK_URL=https://klyro.digital
NGROK_CLIENT_URL=https://klyro.digital


# ── PRODUCTION ──────────────────────────────────────────────────────
#  Used when APP_ENV=production
#  Set these in your hosting platform's environment variables panel
PROD_PORT=5000
PROD_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gifts?retryWrites=true&w=majority
PROD_CLIENT_URL=https://subhsandesh.in
PROD_APP_URL=https://subhsandesh.in
# Optional override for links sent to end-users (recommended when backend runs via ngrok/local)
SHARE_BASE_URL=https://subhsandesh.in


# ── ROOT DOMAIN (subdomain routing + CORS + share URLs) ─────────────
#  Dev:        ROOT_DOMAIN=klyro.digital
#  Production: ROOT_DOMAIN=subhsandesh.in
#  Local:      ROOT_DOMAIN=   (leave empty — no subdomain routing)
ROOT_DOMAIN=klyro.digital


# ═══════════════════════════════════════════════════════════════════
#  SECRETS  —  Generate strong random values for production
#  Run this to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#  Minimum 32 characters. Server WILL NOT START with short secrets in production.
# ═══════════════════════════════════════════════════════════════════
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex_string


# ── EXTERNAL APIs ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── AWS S3 MEDIA STORAGE ─────────────────────────────────────────────
S3_REGION=ap-south-1
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-iam-access-key-id
S3_SECRET_ACCESS_KEY=your-iam-secret-access-key
# Optional CDN/custom domain (without trailing slash)
# If blank, the default S3 public URL is used
S3_PUBLIC_BASE_URL=
# Optional folder prefix inside bucket
S3_UPLOAD_PREFIX=gifts-media

# Optional: override the model used for AI generation (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
