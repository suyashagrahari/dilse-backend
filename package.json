{
  "name": "gifts-server",
  "version": "1.0.0",
  "description": "Express.js + MongoDB backend for Gifts app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "upload:missyou-media": "tsx src/scripts/uploadMissyouMedia.ts",
    "upload:bouquet-media": "tsx src/scripts/uploadBouquetMedia.ts",
    "upload:template-media": "tsx src/scripts/uploadTemplateMedia.ts",
    "upload:guide-media": "tsx src/scripts/uploadGuideMedia.ts",
    "repair:inline-media": "tsx src/scripts/repairInlineMedia.ts",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "leak:check": "node scripts/leak-check.mjs",
    "thread:test": "node scripts/thread-integration.js",
    "prospect:personal:test": "PROSPECT_SEND_START_HOUR=0 PROSPECT_SEND_END_HOUR=0 PPM_MONGO=${PPM_MONGO:-mongodb://localhost:27017/ppm_test} tsx scripts/prospect-personal-integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.998.0",
    "@aws-sdk/client-sesv2": "^3.1123.0",
    "@react-pdf/renderer": "^4.5.1",
    "@types/helmet": "^0.0.48",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.7.8",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.20",
    "maxmind": "^5.0.7",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.2",
    "openai": "^6.22.0",
    "resend": "^6.9.3",
    "sharp": "^0.34.5",
    "sns-validator": "^0.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
